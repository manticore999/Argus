# ── AIOps Configuration ──────────────────────────────────────────────────────
# Template — copy to .env and fill in your values.

# Google Gemini
GOOGLE_API_KEY=your-api-key-here
GEMINI_API_KEYS=key1,key2,key3
GEMINI_MODEL=gemini-2.5-flash-lite

# Prometheus
PROMETHEUS_URL=http://localhost:9090

# Database
DB_PATH=data/aiops.db
